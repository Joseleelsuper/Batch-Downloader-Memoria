flowchart TB
    MYSQL[("MySQL 8.4 compartido")]
    C["Core API\nmigraciones Flyway"] --> CORE["identidad, sesiones, bundles,\njobs, outbox y proyecciones Core"]
    S["Scraper API y scheduler\nmigraciones Alembic"] --> CAT["apps, fuentes, resoluciones,\npipeline y catalog_counters"]
    CORE --> MYSQL
    CAT --> MYSQL

    W["Download worker"] --> H2W[("H2: inbox idempotente")]
    W --> M[("MinIO: ZIP y\nmanifest temporal")]
    N["Notification service"] --> H2N[("H2: inbox idempotente")]
    N --> MAIL["Mailpit / SMTP"]
    T["Translation service"] --> L["Locales JSON versionados"]

    C -. "IDs y correlación" .-> R{{"RabbitMQ"}}
    R -. "comandos" .-> W
    W -. "progreso y resultado" .-> R
    R -. "avisos" .-> N

    SEM["semantic-service"] -. "scaffold sin ruta funcional" .-> PG[("PostgreSQL + pgvector")]

